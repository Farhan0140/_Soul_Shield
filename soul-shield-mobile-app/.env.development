# Local dev backend base URL. The Go backend (F:\Soul_Shield\soul-shield) listens on
# HTTPPORT=3000 by default (see its .env). "localhost" only works from the same machine:
# - iOS simulator / web: http://localhost:3000 works as-is.
# - Android emulator: use http://10.0.2.2:3000 instead (localhost = the emulator itself).
# - Physical device (Expo Go): use your host machine's LAN IP, as below. Both devices
#   must be on the same Wi-Fi network, and the backend must be reachable on that IP
#   (it binds to all interfaces by default, so this should just work).
EXPO_PUBLIC_API_URL=http://192.168.0.104:3000
