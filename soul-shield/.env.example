VERSION=1.0.0
SERVICENAME=Soul-Shield
HTTPPORT=3000

SECRETKEY=change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=5432
DB_NAME=soul_shield
DB_USER=postgres
DB_PASSWORD=change-me
DB_ENABLE_SSL_MODE=false

# Actual connection used at runtime (see config/config.go) — e.g. a Neon/Postgres URL
CONN_STRING_FOR_DB=postgresql://user:password@host:5432/dbname?sslmode=require

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=change-me
