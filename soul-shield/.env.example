# Required
SECRETKEY=change-me-to-at-least-32-random-characters
# Postgres connection URL (e.g. Neon)
CONN_STRING_FOR_DB=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional
# Local-dev port; hosts like Render set PORT instead (default 3000).
HTTPPORT=3000
# Browser origins allowed by CORS, comma-separated ("*" allows any).
# Default: https://soul-shield.vercel.app,http://localhost:5173,http://localhost:4173
# CORS_ORIGINS=https://soul-shield.vercel.app,http://localhost:5173
# How many reverse proxies append to X-Forwarded-For (see util/request.go).
# 0/unset = leftmost entry (spoofable). Verify your host's header before changing.
# TRUSTED_PROXY_HOPS=1
# Informational only.
VERSION=1.0.0
SERVICENAME=Soul-Shield

# Database integration tests only (go test ./repo/). Point at a DISPOSABLE
# database: the tests truncate every table.
# TEST_DATABASE_URL=postgres://test:test@localhost:5432/soulshield_test?sslmode=disable
