    "definitions": {
        "category.CategoryResponse": {
            "type": "object",
            "properties": {
                "color_hex": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "category.CreateCategoryRequest": {
            "type": "object",
            "properties": {
                "color_hex": {
                    "type": "string",
                    "example": "#4F46E5"
                },
                "name": {
                    "type": "string",
                    "example": "Ibadah"
                }
            }
        },
        "category.ErrorResponse": {
            "type": "object",
