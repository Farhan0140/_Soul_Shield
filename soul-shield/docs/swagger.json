                }
            }
        },
        "category.UpdateCategoryRequest": {
            "type": "object",
            "properties": {
                "color_hex": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "otp.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request"
                }
            }
        },
        "otp.SendOTPRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                }
            }
        },
        "otp.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "OTP sent successfully"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "otp.VerifyOTPRequest": {
            "type": "object",
